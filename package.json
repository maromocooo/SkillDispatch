{
  "name": "skilldispatch",
  "version": "0.1.0",
  "description": "Observable multi-skill routing for Claude Code and Codex.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maromocooo/SkillDispatch.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "examples/demo",
    "examples/*.yaml",
    "evals",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:jev-live": "pnpm build && node scripts/jev-live.mjs",
    "skilldispatch": "node dist/cli/index.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "commander": "^13.1.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "^1.4.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.6"
  },
  "bin": {
    "skilldispatch": "dist/cli/index.js"
  },
  "homepage": "https://github.com/maromocooo/SkillDispatch#readme",
  "bugs": {
    "url": "https://github.com/maromocooo/SkillDispatch/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent-skills",
    "skill-routing",
    "jev",
    "observability",
    "developer-tools"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
