{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "traceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "agent": {
      "type": "string",
      "const": "codex"
    },
    "mode": {
      "type": "string",
      "enum": [
        "shadow",
        "advisory"
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "skillInvocationTelemetry": {
          "not": {}
        },
        "skillInstructionReadTelemetry": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "codex-advisory"
          ]
        },
        "injectedSkillIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "kind",
        "injectedSkillIds"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "storage": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "storage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "storage": {
              "type": "string",
              "const": "hash"
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Installation-local HMAC of exact prompt text; identical text correlates across submissions."
            }
          },
          "required": [
            "storage",
            "hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "storage": {
              "type": "string",
              "const": "raw"
            },
            "raw": {
              "type": "string"
            }
          },
          "required": [
            "storage",
            "raw"
          ],
          "additionalProperties": false
        }
      ]
    },
    "host": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "UserPromptSubmit"
        },
        "sessionKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "promptKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Installation-local HMAC of the host prompt submission ID (Codex turn_id or Claude prompt_id), separated by host. Different submission IDs produce different keys even for identical prompt text."
        },
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "skillCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "enabledSkillCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "fingerprint",
        "skillCount",
        "enabledSkillCount"
      ],
      "additionalProperties": false
    },
    "router": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "provider",
        "latencyMs"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxSkills": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "threshold",
        "maxSkills"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "enum": [
              "codex",
              "claude-code",
              "generic"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "user",
              "admin",
              "system",
              "unknown"
            ]
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "catalogIdentity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Path-free adapter-owned catalog identity for exact version correlation."
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "selected": {
            "type": "boolean",
            "description": "Selected by SkillDispatch routing policy; not evidence of host invocation."
          }
        },
        "required": [
          "skillId",
          "name",
          "agent",
          "scope",
          "contentHash",
          "probability",
          "selected"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "skillIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "required": [
          "code",
          "level"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "traceId",
    "timestamp",
    "agent",
    "mode",
    "prompt",
    "host",
    "catalog",
    "router",
    "policy",
    "outcome",
    "decisions",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$id": "https://skilldispatch.dev/schemas/route-trace-v2.json",
  "title": "SkillDispatch Route Trace v2",
  "description": "Codex routing and emitted context. Observer configuration is not delivery or completeness."
}
